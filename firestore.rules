rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.(com|mom)$')
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow read, update, delete: if false;
    }
    match /searches/{searchId} {
      allow create: if request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 300;
      allow read, update, delete: if false;
    }
  }
}
